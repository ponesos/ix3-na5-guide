{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ix3-na5/schemas/meta.schema.json",
  "title": "Site meta",
  "type": "object",
  "additionalProperties": false,
  "required": ["siteName", "tagline", "updatedAt", "unofficial", "fx", "vehicleId"],
  "properties": {
    "siteName": { "type": "string" },
    "tagline": { "type": "string" },
    "updatedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "unofficial": { "type": "boolean" },
    "vehicleId": { "type": "string" },
    "fx": {
      "type": "object",
      "required": ["eurKrw", "gbpKrw", "asOf", "source"],
      "properties": {
        "eurKrw": { "type": "number" },
        "gbpKrw": { "type": "number" },
        "asOf": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "eurKrwAsOf": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "gbpKrwAsOf": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "source": { "type": "string" },
        "sourceUrl": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
