{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ix3-na5/schemas/accessories.schema.json",
  "title": "Accessories catalog",
  "type": "object",
  "required": ["vehicleId", "updatedAt", "items"],
  "properties": {
    "vehicleId": { "type": "string" },
    "updatedAt": { "type": "string" },
    "sourceNoteKo": { "type": "string" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "origin",
          "titleKo",
          "titleOriginal",
          "titleOriginalLang",
          "summaryKo",
          "category",
          "markets",
          "na5Dedicated"
        ],
        "properties": {
          "id": { "type": "string" },
          "origin": {
            "type": "string",
            "enum": ["oem", "thirdParty"],
            "description": "oem=BMW 정품(오리지널), thirdParty=서드파티"
          },
          "oemPartNumber": {
            "type": "string",
            "description": "BMW 품번. 정품은 권장, 서드파티는 생략 가능"
          },
          "brandKo": { "type": "string", "description": "서드파티 브랜드명" },
          "sellerSku": { "type": "string", "description": "판매처·쇼핑몰 상품코드" },
          "titleKo": { "type": "string" },
          "titleOriginal": { "type": "string" },
          "titleOriginalLang": {
            "type": "string",
            "enum": ["de", "en", "nl", "ko"]
          },
          "summaryKo": { "type": "string" },
          "category": {
            "type": "string",
            "enum": ["interior", "cargo", "charging", "wheels", "exterior", "other"]
          },
          "fitmentNotes": { "type": "string" },
          "disclaimer": { "type": "string" },
          "na5Dedicated": { "type": "boolean" },
          "confidence": {
            "type": "string",
            "enum": ["confirmed", "inferred", "unverified"]
          },
          "image": {
            "type": "object",
            "additionalProperties": false,
            "required": ["src", "altKo", "credit"],
            "properties": {
              "src": { "type": "string" },
              "altKo": { "type": "string" },
              "credit": {
                "type": "string",
                "enum": ["owner", "contributor", "licensed", "placeholder"]
              },
              "creditKo": { "type": "string" }
            }
          },
          "markets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["country", "sourceUrl", "price", "currency", "asOf"],
              "properties": {
                "country": {
                  "type": "string",
                  "enum": ["DE", "UK", "NL", "KR", "EB"],
                  "description": "EB = eBay marketplace listing"
                },
                "sourceUrl": { "type": "string" },
                "price": { "type": "number" },
                "listPrice": { "type": "number" },
                "currency": {
                  "type": "string",
                  "enum": ["EUR", "GBP", "KRW"]
                },
                "asOf": { "type": "string" },
                "promoUntil": { "type": "string" },
                "shopProductId": { "type": "string" },
                "priceNoteKo": { "type": "string" },
                "channelKo": {
                  "type": "string",
                  "description": "예: 네이버쇼핑, BMW 공식몰"
                }
              }
            }
          }
        }
      }
    }
  }
}
