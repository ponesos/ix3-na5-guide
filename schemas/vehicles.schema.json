{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ix3-na5/schemas/vehicles.schema.json",
  "title": "Vehicles catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["updatedAt", "defaultVehicleId", "items"],
  "properties": {
    "updatedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "defaultVehicleId": { "type": "string" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "displayNameKo", "status"],
        "properties": {
          "id": { "type": "string", "description": "Folder name under data/vehicles/" },
          "displayNameKo": { "type": "string" },
          "codeName": { "type": "string" },
          "blurbKo": { "type": "string" },
          "status": { "type": "string", "enum": ["ready", "placeholder"] }
        }
      }
    }
  }
}
